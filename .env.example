# Canonical production URL (no trailing slash). Used for sitemap, robots,
# canonical/hreflang tags, and JSON-LD. Must be set on Vercel (Production
# environment) — without it, these fall back to the per-deployment VERCEL_URL,
# which Search Console rejects as an invalid sitemap host.
NEXT_PUBLIC_SITE_URL=https://mellon.design

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Zoho Flow webhook URL (contact-form notification). Treat as a secret.
CONTACT_WEBHOOK_URL=

# Admin editor for site projects (/admin). Server-only — never prefix with NEXT_PUBLIC_.
# ADMIN_PASSWORD is the login password; ADMIN_SESSION_SECRET signs the session
# cookie and must be a separate, random value (not the password itself).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# DeepSeek API key, used only by the admin "duplicate to locale" translate action.
DEEPSEEK_API_KEY=
